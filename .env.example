# Copy to .env.local and fill in from the Supabase dashboard (Project settings, API).
# Leave both empty to run local-only: the app and its tests work with no backend.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the web-hosted full guides opened from Theory Primer cards (no trailing slash needed).
# Each Node appends its slug, e.g. https://your.site/guides/doorbell. Leave empty to hide the guide button.
EXPO_PUBLIC_TUTORIAL_BASE=

# Base URL of the hosted Lesson Animations (no trailing slash needed), e.g. the public Supabase Storage bucket
# https://<project-ref>.supabase.co/storage/v1/object/public/lesson-media. Clips live at <base>/animations/<key>.mp4.
# Must be https. Leave empty to hide animation blocks; it is never derived from EXPO_PUBLIC_SUPABASE_URL.
EXPO_PUBLIC_MEDIA_BASE=

# RevenueCat public SDK keys for Apple App Store and Google Play Store.
# Leave empty to use MockBillingService (development, web, and tests).
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=

# AdMob ad unit IDs, used only in release builds (development builds always use Google's test units).
# Leave empty to fall back to the test units. Also replace the sample App IDs in app.json before release.
EXPO_PUBLIC_ADMOB_BANNER_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=
