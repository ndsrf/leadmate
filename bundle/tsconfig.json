{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": ["./**/*.ts", "../src/sim/**/*.ts", "../src/i18n/**/*.ts", "../src/hud/**/*.ts"],
  "exclude": ["**/*.test.ts", "../src/**/*.test.ts", "vite.config.mts"]
}
