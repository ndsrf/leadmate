{
  "name": "leadmate",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "npm run sim:embed && expo start",
    "android": "npm run sim:embed && expo start --android",
    "ios": "npm run sim:embed && expo start --ios",
    "web": "expo start --web",
    "sim:dev": "vite --config bundle/vite.config.mts",
    "sim:build": "node scripts/gen-hud-tokens.mjs && vite build --config bundle/vite.config.mts",
    "test": "jest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p bundle",
    "sim:embed": "node scripts/embed-sim.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo/metro-runtime": "~58.0.15",
    "@fission-ai/openspec": "^1.14.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-screen-orientation": "~58.0.3",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "nativewind": "^4.2.7",
    "phaser": "^3.90.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "playwright-core": "^1.64.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4"
  }
